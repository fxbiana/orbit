# Clerk Dashboard → API keys. The secret stays on the API.
CLERK_SECRET_KEY=
# Optional PEM public key. When set, token checks stay on this machine.
CLERK_JWT_KEY=

# azp claim for the unpacked extension. The id comes from manifest.config.ts.
CLERK_AUTHORIZED_PARTIES=chrome-extension://gpnknnpdogpdgeejedabdihnacblhmmj
CORS_ORIGINS=chrome-extension://gpnknnpdogpdgeejedabdihnacblhmmj

# Absolute path to the Firebase service account JSON.
# Dev and prod use this same Firebase project. There is no emulator.
FIREBASE_CREDENTIALS_PATH=
