# clerk verifies a session token. local reads X-User-Id.
AUTH_MODE=clerk

# Clerk Dashboard → API keys. Required while AUTH_MODE=clerk.
CLERK_SECRET_KEY=
# Optional PEM public key. When set, token checks stay on this machine.
CLERK_JWT_KEY=

# Origins that may mint a session token. azp must match one of these exactly.
# Include the website, 127.0.0.1, the extension dev server, the extension id,
# and this instance's Frontend API origin (https://<slug>.clerk.accounts.dev).
CLERK_AUTHORIZED_PARTIES=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5173,http://127.0.0.1:5173,chrome-extension://gpnknnpdogpdgeejedabdihnacblhmmj
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5173,http://127.0.0.1:5173,chrome-extension://gpnknnpdogpdgeejedabdihnacblhmmj

# Absolute path to the Firebase service account JSON.
# Dev and prod use this same Firebase project. There is no emulator.
FIREBASE_CREDENTIALS_PATH=

# Ticketmaster Discovery API key. Nearby events use the signed-in profile's
# location and saved preferences. Leave empty until you have a key.
TICKETMASTER_API_KEY=

# Optional. Spotify import uses this model to suggest topic chips.
# When either value is empty, import falls back to genre chips only.
AI_API_KEY=
AI_MODEL=
